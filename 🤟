local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

local uiParent = (gethui and gethui()) or CoreGui

if uiParent:FindFirstChild("SimpleSkyboxUI") then
	uiParent.SimpleSkyboxUI:Destroy()
end

-- Função para aplicar o mesmo ID em todas as faces
local function aplicarIdUnico(assetId)
	local idFormatado = "rbxassetid://" .. tostring(assetId)
	
	local skyObj = Lighting:FindFirstChildOfClass("Sky")
	if not skyObj then
		skyObj = Instance.new("Sky")
		skyObj.Parent = Lighting
	end
	
	-- Aplica a mesma imagem nas 6 direções
	skyObj.SkyboxBk = idFormatado
	skyObj.SkyboxDn = idFormatado
	skyObj.SkyboxFt = idFormatado
	skyObj.SkyboxLf = idFormatado
	skyObj.SkyboxRt = idFormatado
	skyObj.SkyboxUp = idFormatado
	
	print("🌌 [Skybox] Aplicado ID único:", assetId)
end

local function restaurarOriginal()
	local skyObj = Lighting:FindFirstChildOfClass("Sky")
	if skyObj then
		skyObj:Destroy()
		print("🌌 [Skybox] Céu original restaurado.")
	end
end

