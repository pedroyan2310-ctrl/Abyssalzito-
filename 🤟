UIListLayout.Padding = UDim.new(0, 6)
UIListLayout.Parent = Scroll

local renderizarConteudo

local function atualizarAba(novaAba)
	abaAtual = novaAba
	btnTab1.BackgroundColor3 = (abaAtual == "Salvos") and Color3.fromRGB(40, 120, 200) or Color3.fromRGB(30, 30, 38)
	btnTab2.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
	if abaAtual == "Salvos" then
		btnTab1.TextColor3 = Color3.fromRGB(255, 255, 255)
		btnTab2.TextColor3 = Color3.fromRGB(200, 200, 200)
	else
		btnTab2.BackgroundColor3 = Color3.fromRGB(40, 120, 200)
		btnTab2.TextColor3 = Color3.fromRGB(255, 255, 255)
		btnTab1.TextColor3 = Color3.fromRGB(200, 200, 200)
	end
	renderizarConteudo()
end

btnTab1.MouseButton1Click:Connect(function() atualizarAba("Salvos") end)
btnTab2.MouseButton1Click:Connect(function() atualizarAba("Novo") end)

function renderizarConteudo()
	for _, child in ipairs(Scroll:GetChildren()) do
		if child:IsA("GuiObject") and child ~= UIListLayout then
			child:Destroy()
		end
	end
	
	local count = 0
	
	if abaAtual == "Salvos" then
		local salvos = carregarSalvos()
		local temItens = false
		for nomeCeu, dadosCeu in pairs(salvos) do
			temItens = true
			count = count + 1
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, 34)
			row.BackgroundTransparency = 1
			row.Parent = Scroll
			
			local btnApp = Instance.new("TextButton")
			btnApp.Size = UDim2.new(0.72, 0, 1, 0)
			btnApp.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
			btnApp.Text = "✨ " .. nomeCeu
			btnApp.TextColor3 = Color3.fromRGB(46, 204, 113)
			btnApp.Font = Enum.Font.GothamBold
			btnApp.TextSize = 11
			btnApp.TextXAlignment = Enum.TextXAlignment.Left
			btnApp.Parent = row
			local pad = Instance.new("UIPadding")
			pad.PaddingLeft = UDim.new(0, 10)
			pad.Parent = btnApp
			Instance.new("UICorner", btnApp).CornerRadius = UDim.new(0, 6)
			
			btnApp.MouseButton1Click:Connect(function()
				aplicarSkybox(dadosCeu)
			end)
			
			local btnDel = Instance.new("TextButton")
			btnDel.Size = UDim2.new(0.25, 0, 1, 0)
			btnDel.Position = UDim2.new(0.75, 0, 0, 0)
			btnDel.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
			btnDel.Text = "Excluir"
			btnDel.TextColor3 = Color3.fromRGB(255, 255, 255)
			btnDel.Font = Enum.Font.GothamBold
			btnDel.TextSize = 10
			btnDel.Parent = row
			Instance.new("UICorner", btnDel).CornerRadius = UDim.new(0, 6)
			
			btnDel.MouseButton1Click:Connect(function()
				local current = carregarSalvos()
				current[nomeCeu] = nil
				if writefile then
					writefile(saveFileName, HttpService:JSONEncode(current))
				end
				renderizarConteudo()
			end)
		end
		
		if not temItens then
			local vazio = Instance.new("TextLabel")
			vazio.Size = UDim2.new(1, 0, 0, 40)
			vazio.BackgroundTransparency = 1
			vazio.Text = "Nenhum céu salvo ainda.\nClique em '＋ Novo Sky' para criar um!"
			vazio.TextColor3 = Color3.fromRGB(150, 150, 150)
			vazio.Font = Enum.Font.Gotham
			vazio.TextSize = 11
			vazio.Parent = Scroll
		end
		
	elseif abaAtual == "Novo" then
		count = 8
		local boxNome = Instance.new("TextBox")
		boxNome.Size = UDim2.new(1, 0, 0, 30)
		boxNome.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
		boxNome.TextColor3 = Color3.fromRGB(255, 255, 255)
		boxNome.PlaceholderText = "Nome do Céu (ex: Noite Roxo)"
		boxNome.Font = Enum.Font.Gotham
		boxNome.TextSize = 11
		boxNome.Parent = Scroll
		Instance.new("UICorner", boxNome).CornerRadius = UDim.new(0, 6)
		
		local idBoxes = {}
		-- Mapeamento claro em Português para cada face do cubo da Skybox
		local facesConfig = {
			{key = "Ft", label = "Frente (Front ID)"},
			{key = "Bk", label = "Trás (Back ID)"},
			{key = "Lf", label = "Esquerda (Left ID)"},
			{key = "Rt", label = "Direita (Right ID)"},
			{key = "Up", label = "Cima / Céu (Up ID)"},
			{key = "Dn", label = "Baixo / Chão (Down ID)"},
		}
		
		for _, info in ipairs(facesConfig) do
			local b = Instance.new("TextBox")
			b.Size = UDim2.new(1, 0, 0, 28)
			b.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
			b.TextColor3 = Color3.fromRGB(255, 255, 255)
			b.PlaceholderText = info.label
			b.Font = Enum.Font.Gotham
			b.TextSize = 11
			b.Parent = Scroll
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
			idBoxes[info.key] = b
		end
		
		local btnSalvar = Instance.new("TextButton")
		btnSalvar.Size = UDim2.new(1, 0, 0, 32)
		btnSalvar.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
		btnSalvar.Text = "💾 Salvar Céu"
		btnSalvar.TextColor3 = Color3.fromRGB(255, 255, 255)
		btnSalvar.Font = Enum.Font.GothamBold
		btnSalvar.TextSize = 11
		btnSalvar.Parent = Scroll
		Instance.new("UICorner", btnSalvar).CornerRadius = UDim.new(0, 6)
		
		btnSalvar.MouseButton1Click:Connect(function()
			local nomeCeu = boxNome.Text
			if nomeCeu == "" then nomeCeu = "Meu Céu" end
			
			local novaTabela = {}
			for _, info in ipairs(facesConfig) do
				local txt = idBoxes[info.key].Text:match("%d+")
				novaTabela[info.key] = txt and ("rbxassetid://" .. txt) or ""
			end
			
			salvarCeu(nomeCeu, novaTabela)
			atualizarAba("Salvos")
		end)
	end
	
	Scroll.CanvasSize = UDim2.new(0, 0, 0, count * 36 + 20)
end

renderizarConteudo()

