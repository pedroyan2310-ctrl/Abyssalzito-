local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local player = Players.LocalPlayer

local uiParent = (gethui and gethui()) or CoreGui

if uiParent:FindFirstChild("CompactSkyboxToolbox") then
	uiParent.CompactSkyboxToolbox:Destroy()
end

local saveFileName = "VehicleCity_CompactSkyboxes.json"

local function carregarSalvos()
	if isfile and isfile(saveFileName) then
		local success, decoded = pcall(function()
			return HttpService:JSONDecode(readfile(saveFileName))
		end)
		if success and type(decoded) == "table" then
			return decoded
		end
	end
	return {}
end

local function salvarCeu(nome, faces)
	local salvos = carregarSalvos()
	salvos[nome] = faces
	if writefile then
		writefile(saveFileName, HttpService:JSONEncode(salvos))
	end
end

local function aplicarSkybox(tabelaFaces)
	local skyObj = Lighting:FindFirstChildOfClass("Sky")
	if not skyObj then
		skyObj = Instance.new("Sky")
		skyObj.Parent = Lighting
	end
	
	skyObj.SkyboxBk = tabelaFaces.Bk
	skyObj.SkyboxDn = tabelaFaces.Dn
	skyObj.SkyboxFt = tabelaFaces.Ft
	skyObj.SkyboxLf = tabelaFaces.Lf
	skyObj.SkyboxRt = tabelaFaces.Rt
	skyObj.SkyboxUp = tabelaFaces.Up
end

local function restaurarOriginal()
	local skyObj = Lighting:FindFirstChildOfClass("Sky")
	if skyObj then
		skyObj:Destroy()
	end
end

