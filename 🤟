--==========================================
-- HTTP HELPER
--==========================================
local httpReq
do
	httpReq = (syn and syn.request)
		or (http and http.request)
		or http_request
		or (fluxus and fluxus.request)
		or (request)
end

local function http(method, url, body)
	if not httpReq then return nil end
	local ok, resp = pcall(function()
		return httpReq({
			Url = url, Method = method, Body = body,
			Headers = { ["Content-Type"] = "application/json" },
		})
	end)
	if not ok then return nil end
	return resp
end

local function firebaseDisponivel()
	return CONFIG.FIREBASE_URL ~= ""
		and CONFIG.FIREBASE_URL ~= nil
		and httpReq ~= nil
end

--==========================================
-- HELPERS UI
--==========================================
local function novo(classe, props, parent)
	local i = Instance.new(classe)
	if props then for k,v in pairs(props) do i[k] = v end end
	if parent then i.Parent = parent end
	return i
end
local function cantos(i, r) return novo("UICorner", {CornerRadius = UDim.new(0, r or 6)}, i) end
local function gradiente(i, c1, c2, rot)
	return novo("UIGradient", {Color = ColorSequence.new(c1,c2), Rotation = rot or 0}, i)
end
local function stroke(i, cor, esp, tr)
	return novo("UIStroke", {Color=cor or C.border, Thickness=esp or 1, Transparency=tr or 0.4}, i)
end
local function fnum(v, step)
	if step >= 1 then return tostring(math.floor(v + 0.5)) end
	local s = string.format("%.2f", v):gsub("(%-?%d+%.?%d-)0+$", "%1"):gsub("%.$", "")
	return s
end

