RunService.RenderStepped:Connect(function(dt)
	State.tempo = State.tempo + dt
	local p = State.part
	if not p or not p.Parent then return end
	if State.rainbow and State.light then
		State.light.Color = Color3.fromHSV((State.tempo * 0.25) % 1, 1, 1)
	end
	if State.pulse and State.light then
		local vel = W["Velocidade do Pulso"] and W["Velocidade do Pulso"]:get() or 4
		State.light.Brightness = State.bright * (0.6 + math.sin(State.tempo * vel) * 0.4)
	end
	if State.spin and State.weld then
		local vel = W["Velocidade do Giro"] and W["Velocidade do Giro"]:get() or 45
		State.spinAngle = (State.spinAngle + dt * vel) % 360
		State.weld.C0 = State.baseRot * CFrame.Angles(0, math.rad(State.spinAngle), 0)
	end
end)

