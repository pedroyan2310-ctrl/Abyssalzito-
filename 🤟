render = function()
	if W["Tamanho X"] then State.sx = W["Tamanho X"]:get() end
	if W["Tamanho Y"] then State.sy = W["Tamanho Y"]:get() end
	if W["Tamanho Z"] then State.sz = W["Tamanho Z"]:get() end
	if W["PosiÃ§Ã£o X"] then State.px = W["PosiÃ§Ã£o X"]:get() end
	if W["PosiÃ§Ã£o Y"] then State.py = W["PosiÃ§Ã£o Y"]:get() end
	if W["PosiÃ§Ã£o Z"] then State.pz = W["PosiÃ§Ã£o Z"]:get() end
	if W["RotaÃ§Ã£o X"] then State.rx = W["RotaÃ§Ã£o X"]:get() end
	if W["RotaÃ§Ã£o Y"] then State.ry = W["RotaÃ§Ã£o Y"]:get() end
	if W["RotaÃ§Ã£o Z"] then State.rz = W["RotaÃ§Ã£o Z"]:get() end
	if W["TransparÃªncia"] then State.transp = W["TransparÃªncia"]:get() end
	if W["Vermelho (R)"] then State.cr = W["Vermelho (R)"]:get() end
	if W["Verde (G)"] then State.cg = W["Verde (G)"]:get() end
	if W["Azul (B)"] then State.cb = W["Azul (B)"]:get() end
	if W["Intensidade"] then State.bright = W["Intensidade"]:get() end
	if W["Alcance"] then State.range = W["Alcance"]:get() end
	if W["Ã‚ngulo"] then State.angle = W["Ã‚ngulo"]:get() end

	local p = State.part
	if not p or not p.Parent then return end

	local transAlvo = State.mostrarCaixa and State.transp or math.max(State.transp, 1)
	p.Size = Vector3.new(State.sx, State.sy, State.sz)
	p.Transparency = transAlvo

	State.baseRot = CFrame.new(State.px, State.py, State.pz)
		* CFrame.Angles(math.rad(State.rx), math.rad(State.ry), math.rad(State.rz))

	if State.weld then
		State.weld.C0 = State.baseRot
			* CFrame.Angles(0, math.rad(State.spinAngle), 0)
	end
	if State.light then
		if not State.rainbow then
			State.light.Color = Color3.fromRGB(State.cr, State.cg, State.cb)
		end
		State.light.Brightness = State.bright
		State.light.Range = State.range
		State.light.Angle = State.angle
	end
	if State.imgLabel then
		State.imgLabel.Image = (State.imgId ~= "")
			and ("rbxthumb://type=Asset&id="..State.imgId.."&w=420&h=420") or ""
	end
end

